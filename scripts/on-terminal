#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

if [[ "$#" -eq 0 ]]; then
  echo "Run scripts/on-terminal <command> [argument...]." >&2
  exit 2
fi

if script -q /dev/null true >/dev/null 2>&1 </dev/null; then
  script -q /dev/null "$@" </dev/null
else
  script -qec "$(printf '%q ' "$@")" /dev/null </dev/null
fi
