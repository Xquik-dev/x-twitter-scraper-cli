# Runs a command on a new pseudo-terminal with nothing to read, and exits
# with the command's exit code. Use it to see what a script or a test does
# when a maintainer starts it from a terminal.

set -euo pipefail

if [[ "$#" -eq 0 ]]; then
  echo "Run scripts/on-terminal <command> [argument...]." >&2
  exit 2
fi

# The script tool takes its command in 2 ways. BSD and macOS read it as
# arguments, and util-linux reads it as 1 string.
if script -q /dev/null true >/dev/null 2>&1 </dev/null; then
  script -q /dev/null "$@" </dev/null
else
  script -qec "$(printf '%q ' "$@")" /dev/null </dev/null
fi
