set -euo pipefail

cd "$(dirname "$0")/.."

echo "==> Verifying module checksums"
go mod verify

echo "==> Scanning reachable vulnerabilities"
go run golang.org/x/vuln/cmd/govulncheck@v1.9.0 ./...
