#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

cd "$(dirname "$0")/.."

export GOPRIVATE="${GOPRIVATE:+$GOPRIVATE,}github.com/Xquik-dev/x-twitter-scraper-go"
echo "==> Running tests"
go mod verify
go test -race ./... "$@"

if [[ "$#" -eq 0 ]]; then
  echo "==> Enforcing statement coverage"
  ./scripts/coverage
  ./scripts/branch-coverage
  echo "==> Running tests on a terminal"
  ./scripts/test-on-terminal
fi

echo "==> Checking tests on Windows"
GOARCH=amd64 GOOS=windows go test -c ./... "$@"
find . -name "*.test.exe" -exec rm {} \;
