set -euo pipefail

cd "$(dirname "$0")/.."

export GOPRIVATE="${GOPRIVATE:+$GOPRIVATE,}github.com/Xquik-dev/x-twitter-scraper-go"

echo "==> Building x-twitter-scraper"
go build ./cmd/x-twitter-scraper
